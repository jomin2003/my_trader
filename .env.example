# ---- SECRETS (set in Render dashboard; never commit real values) ----
DHAN_CLIENT_ID=<required>
DHAN_ACCESS_TOKEN=<required>
DHAN_PIN=<required>
DHAN_TOTP_SECRET=<required>
TG_BOT_TOKEN=<required>
TG_CHAT_ID=<required>
CRON_SECRET=<any-random-string>
GITHUB_TOKEN=<pat-with-gist-scope>
GITHUB_GIST_ID=<gist-id>
KRONOS_GIST_ID=
VOL_GIST_ID=
LEDGER_GIST_ID=
GIST_TOKEN=
# ---- Runtime ----
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
# ---- Phase flags (safe defaults = paper, no behaviour change) ----
AUDIT_ENABLED=1
EXIT_POLICY_V2_ENABLED=0
APP_PROFILE=paper
CONFIG_DIR=./configs
PERSISTENCE_BACKEND=gist
PORTFOLIO_RISK_ENABLED=0
# ---- ML gates (all default OFF/safe) ----
RR_GATE_ENABLED=0
RR_MODEL_PATH=./rr_model.txt
RR_META_PATH=./rr_meta.json
RR_MIN_SKILL=0.0
RR_MIN_PRED_R=0.0
KRONOS_ENABLED=true
KRONOS_MODE=soft
KEXIT_ENABLED=true
VOL_GATE_ENABLED=0
ALLOC_MODE=shadow
# ---- Risk limits ----
MIN_SL_PCT=0.003
MAX_SL_PCT=0.015
EXIT_MIN_RR=1.2
MAX_RISK_PER_TRADE=500
