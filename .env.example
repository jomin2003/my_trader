# ---- SECRETS (set in Render dashboard; never commit real values) ----
DHAN_CLIENT_ID=<required>
DHAN_ACCESS_TOKEN=<required>
DHAN_PIN=<required>
DHAN_TOTP_SECRET=<required>
TG_BOT_TOKEN=<required>
TG_CHAT_ID=<required>
CRON_SECRET=<any-random-string>
GITHUB_TOKEN=<pat-with-gist-scope>
GITHUB_GIST_ID=<gist-id>
KRONOS_GIST_ID=
VOL_GIST_ID=
LEDGER_GIST_ID=
GIST_TOKEN=
# ---- Runtime ----
PYTHONUNBUFFERED=1
TZ=Asia/Kolkata
# ---- Phase flags (safe defaults = paper, no behaviour change) ----
AUDIT_ENABLED=1
EXIT_POLICY_V2_ENABLED=0
# ---- ML gates (all default OFF/safe) ----
RR_GATE_ENABLED=0
RR_MODEL_PATH=./rr_model.txt
RR_META_PATH=./rr_meta.json
RR_MIN_SKILL=0.0
RR_MIN_PRED_R=0.0
KRONOS_ENABLED=true
KRONOS_MODE=soft
KEXIT_ENABLED=true
VOL_GATE_ENABLED=0
ALLOC_MODE=shadow
# ---- Risk limits ----
# Keep MIN_SL_PCT in sync with config_registry default (0.006): it sets the cost/R
# floor that the profitability design depends on (0.003 halves every stop floor).
MIN_SL_PCT=0.006
MAX_SL_PCT=0.015
EXIT_MIN_RR=1.2
MAX_RISK_PER_TRADE=500
# ---- Regime / side control (research 2026-09: see docs/RESEARCH_2026-09.md) ----
# Strict NIFTY gate: only trade in the index's intraday direction
NIFTY_GATE_ENABLED=1
NIFTY_STRICT=1
# Block losing (strategy,direction) pairs, e.g. VWAP_RECLAIM:+1,SUPERTREND:-1
SIDE_BLOCK=
# ORB: trade only in the direction of the first 5-min candle (Concretum)
ORB_FIRST_CANDLE_DIR=0
